[importlinter]
root_packages =
    aeroadapt
    reference
include_external_packages = False

# ADR-006: the flight stack never sees privileged simulator state or fault ground truth.
[importlinter:contract:stack-has-no-privileged-access]
name = Flight stack must not import the simulator or faultlab
type = forbidden
source_modules =
    aeroadapt.stack
forbidden_modules =
    aeroadapt.sim
    aeroadapt.faultlab

# N-version validation (V3): the reference implementation and the production
# simulator must stay independent in both directions.
[importlinter:contract:product-does-not-use-reference]
name = Production code must not import the reference implementation
type = forbidden
source_modules =
    aeroadapt
forbidden_modules =
    reference

[importlinter:contract:reference-is-independent]
name = Reference implementation must not import production code
type = forbidden
source_modules =
    reference
forbidden_modules =
    aeroadapt

# The flight stack is a pure consumer of messages: it never reaches into a vehicle backend or
# the harness that couples it to the simulator.
[importlinter:contract:stack-is-backend-agnostic]
name = Flight stack must not import vehicle backends or harnesses
type = forbidden
source_modules =
    aeroadapt.stack
forbidden_modules =
    aeroadapt.vehicle
    aeroadapt.harness

# The simulator and the vehicle adapters know nothing about the autopilot that flies them.
[importlinter:contract:plant-does-not-know-the-controller]
name = Simulator and vehicle adapters must not import the flight stack
type = forbidden
source_modules =
    aeroadapt.sim
    aeroadapt.vehicle
    aeroadapt.faultlab
forbidden_modules =
    aeroadapt.stack
    aeroadapt.harness

# M2 spec §2: the airframe generator runs offline (AeroSandbox). Nothing that flies imports it;
# generated airframes reach the simulator only as data (fleet bundles).
[importlinter:contract:generator-is-offline]
name = Simulator, stack, vehicles and scenarios must not import the generator
type = forbidden
source_modules =
    aeroadapt.sim
    aeroadapt.stack
    aeroadapt.vehicle
    aeroadapt.faultlab
    aeroadapt.harness
    aeroadapt.scenarios
    aeroadapt.telemetry
forbidden_modules =
    aeroadapt.generator
